# Copie este arquivo para .env e preencha com valores reais. Nunca commite o
# .env de verdade. Detalhes de cada variável em docs/03-variaveis-de-ambiente.md.

# --- Essenciais -------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/m_agendy"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# --- Autenticação (BetterAuth) ----------------------------------------------
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Pagamentos / Assinatura (Stripe) ----------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_PRODUCT_ID=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_ESSENTIAL_PLAN_PRICE_ID=""
STRIPE_PREMIUM_PLAN_PRICE_ID=""
STRIPE_GOLD_PLAN_PRICE_ID=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=""

# --- WhatsApp (Meta Cloud API) -----------------------------------------------
WHATSAPP_API_URL="https://graph.facebook.com/v20.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_DEFAULT_CLINIC_ID=""
# Nomes dos templates aprovados no WhatsApp Manager (ver docs/11-plano-notificacoes-whatsapp.md).
# Sem eles, confirmação/lembrete caem em modo dev (só log), mesmo com as credenciais acima preenchidas.
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"
WHATSAPP_TEMPLATE_CONFIRMATION_NAME=""
WHATSAPP_TEMPLATE_REMINDER_NAME=""
WHATSAPP_TEMPLATE_CANCELLATION_NAME=""

# --- Lembretes (fila QStash) --------------------------------------------------
QSTASH_TOKEN=""
REMINDER_DISPATCH_URL="http://localhost:3000/api/reminders/dispatch"
# Chaves de assinatura do QStash (console da Upstash) — validam o header
# Upstash-Signature em /api/reminders/dispatch. Sem elas, o endpoint aceita
# qualquer requisição (modo dev).
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# --- E-mail (SMTP / contato) --------------------------------------------------
EMAIL_SERVICE="gmail"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM_NAME="M.Agendy"
CONTACT_EMAIL=""
